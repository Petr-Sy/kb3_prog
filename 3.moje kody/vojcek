 <!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>TEST WEB</title>
        <style>
            body {
                background-image: url('bruno.jpg');
                background-size: cover;
                background-repeat: no-repeat;
                background-position: center;
                height: 100vh;
                width: 100vw;
                margin: 0;
                overflow-x: hidden;
            }

            /* Styl pro obrázek s rámečkem */
            .ramecek-obrazku {
                border: 5px solid black;
                border-radius: 10px;
                padding: 5px;
                background-color: white;
            }

            /* Kontejner pro obrázky vedle sebe - posunutý níže přes margin-top */
            .galerie-toth {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 50px; /* Větší odstup shora */
            }

            /* Pozice pro celou postavu na pravém kraji uprostřed */
            .postava-container {
                position: fixed;
                right: 50px;
                top: 50%;
                transform: translateY(-50%);
                display: flex;
                flex-direction: column;
                align-items: center;
                width: 140px;
            }

            /* Obrázek hlavy */
            .hlava {
                width: 70px;
                height: 70px;
                object-fit: cover;
                border-radius: 50%;
                border: 3px solid white;
                z-index: 2;
                position: relative;
                margin-bottom: -15px;
            }

            /* Trup s rukama – nově červená barva */
            .trup {
                width: 90px;
                height: 110px;
                background-color: #e74c3c; /* Červená barva oblečení */
                border-top-left-radius: 20px;
                border-top-right-radius: 20px;
                border-bottom-left-radius: 10px;
                border-bottom-right-radius: 10px;
                position: relative;
                z-index: 1;
            }

            /* Levá ruka */
            .ruka-leva {
                width: 20px;
                height: 90px;
                background-color: #e74c3c;
                position: absolute;
                left: -22px;
                top: 5px;
                border-radius: 10px;
                transform: rotate(15deg);
                transform-origin: top center;
            }

            /* Pravá ruka */
            .ruka-prava {
                width: 20px;
                height: 90px;
                background-color: #e74c3c;
                position: absolute;
                right: -22px;
                top: 5px;
                border-radius: 10px;
                transform: rotate(-15deg);
                transform-origin: top center;
            }

            /* Kontejner pro nohy */
            .nohy-container {
                display: flex;
                justify-content: space-between;
                width: 60px;
                margin-top: -2px;
            }

            /* Nohy – nově sytě modrá/tmavší barva kalhot */
            .noha {
                width: 22px;
                height: 80px;
                background-color: #2980b9; /* Modrá barva kalhot */
                border-bottom-left-radius: 10px;
                border-bottom-right-radius: 10px;
            }
        </style>
    </head>
    <body>
        <h1>Havlis</h1>
        <p>Takhle pisu text!!</p>
        <br>
        <p>dalsi odstavec<br>dalsi radek</p>
        <i>Pavelka</i>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <!-- Původní obrázek s rámečkem -->
        <img src="Image.jpg" width="100" class="ramecek-obrazku">

        <!-- Galerie toth posunutá níže -->
        <div class="galerie-toth">
            <img src="toth.jpg" width="30">
            <img src="toth.jpg" width="40">
            <img src="toth.jpg" width="50">
            <img src="toth.jpg" width="60">
            <img src="toth.jpg" width="70">
            <img src="toth.jpg" width="80">
            <img src="toth.jpg" width="90">
            <img src="toth.jpg" width="100">
            <img src="toth.jpg" width="110">
            <img src="toth.jpg" width="120">
            <img src="toth.jpg" width="130">
            <img src="toth.jpg" width="120">
            <img src="toth.jpg" width="110">
            <img src="toth.jpg" width="100">
            <img src="toth.jpg" width="90">
            <img src="toth.jpg" width="80">
            <img src="toth.jpg" width="70">
            <img src="toth.jpg" width="60">
        </div>

        <!-- Postava na pravém kraji -->
        <div class="postava-container">
            <img src="hlava.jpg" class="hlava" alt="Hlava">
            <div class="trup">
                <div class="ruka-leva"></div>
                <div class="ruka-prava"></div>
            </div>
            <div class="nohy-container">
                <div class="noha"></div>
                <div class="noha"></div>
            </div>
        </div>
    </body>
</html>
